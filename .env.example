# Copy this file to .env and fill in your values
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...

# Optional overrides
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=1.0          # set to 0.0 for reproducible strategy comparisons
SYSTEM_PROMPT=You are a helpful assistant.

# Redis — set automatically by docker-compose; override for local dev
REDIS_URL=redis://localhost:6379

# LiteLLM proxy — set automatically by docker-compose; override for local dev
# Leave unset to bypass the proxy and call OpenAI directly
LITELLM_BASE_URL=http://localhost:4000/v1

# Embeddings — used by both session RAG and document RAG
# openai  — uses OpenAI text-embedding-3-small (requires OPENAI_API_KEY)
# local   — uses a HuggingFace model loaded from EMBEDDING_MODEL_PATH volume
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small        # used by openai provider
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2  # used by local provider
EMBEDDING_MODEL_PATH=/app/models              # path inside container (volume mount)

# Document RAG
DOC_TOP_K=3     # number of document chunks to retrieve per query

# Chat history strategy — controls token cost vs. context trade-off
# full      — send entire history every turn (default, highest cost)
# trim      — truncate history to MAX_HISTORY_TOKENS before each LLM call
# summarize — compress old messages into a running summary after SUMMARIZE_AFTER messages
# rag       — retrieve only top-k semantically relevant past messages via FAISS
# smart     — router-based: window | raw-log | filter→vector | pure vector per query
HISTORY_STRATEGY=full
MAX_HISTORY_TOKENS=1000      # used by trim strategy
SUMMARIZE_AFTER=3            # used by summarize strategy (message count threshold)
RAG_TOP_K=4                  # used by rag/smart strategies (top-k retrieved messages)

# smart strategy
WINDOW_SIZE=6                              # sliding window length (last N messages kept raw)
CHUNK_SIZE=6                               # messages per summary chunk (outside-window batching)
TOPIC_NAMING_MODEL=gpt-4o-mini             # cheap LLM used to name new topic clusters
TOPIC_SIMILARITY_THRESHOLD=0.65            # cosine threshold to join existing cluster (0.0-1.0)

# Logging
CHAT_LOG=logs/chat.log       # one NDJSON line per message (always on)
DEBUG_LOG=logs/debug.log     # verbose internal state (only written when DEBUG=true)
DEBUG=false
