# Credentials and deployment-specific URLs only.
# Application behavior (history strategy, embeddings provider, eval mode, etc.)
# lives in config.yaml at the repo root.

# Required
OPENAI_API_KEY=sk-...

# Required only for Anthropic models
ANTHROPIC_API_KEY=sk-...

# Set automatically by docker-compose; override only for local dev
REDIS_URL=redis://localhost:6379

# LiteLLM proxy URL. Set automatically by docker-compose; leave unset to bypass
# the proxy and call OpenAI directly.
LITELLM_BASE_URL=http://localhost:4000/v1

# Path inside the backend container where HuggingFace models are cached.
# Only used by the local embedding provider.
EMBEDDING_MODEL_PATH=/app/models

# Postgres — credentials for the postgres service in docker-compose.
# Set automatically by docker-compose; override only if running outside Docker.
PG_USER=yourusername
PG_PASSWORD=yourpassword
PG_DB=yourdbname